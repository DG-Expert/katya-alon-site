var WORKSHOP_PUBLISH={SHEET_NAME:'\u05e0\u05d9\u05d4\u05d5\u05dc \u05e1\u05d3\u05e0\u05d0\u05d5\u05ea',HEADER_ROW:4,FIRST_DATA_ROW:5,COLUMN_COUNT:10,REPO:'DG-Expert/katya-alon-site',FILE:'content/workshop.yaml',BRANCH:'sheet-workshop-drafts',ARMED_VALUE:'I_HAVE_SYNCED_LOCAL_CHANGES_AND_REVIEWED_DRAFTS',HEADERS:['\u05ea\u05d7\u05d5\u05dd','\u05de\u05e4\u05ea\u05d7 YAML','\u05ea\u05d5\u05d5\u05d9\u05ea','\u05e2\u05e8\u05da (\u05e2\u05d1\u05e8\u05d9\u05ea \u05d0\u05d5 \u05e2\u05e8\u05da \u05d9\u05d7\u05d9\u05d3)','English','\u0420\u0443\u0441\u0441\u043a\u0438\u0439','\u05e1\u05d5\u05d2','\u05d7\u05d5\u05d1\u05d4','\u05de\u05e6\u05d1','\u05e2\u05d6\u05e8\u05d4'],SCALAR:{layout:'text','sections.content_1':'boolean','sections.content_2':'boolean','sections.power_image':'boolean','sections.content_3':'boolean','sections.pricing':'boolean','sections.instructor':'boolean','event.workshop_id':'id','event.timezone':'text','event.first_session_date':'date','event.second_session_date':'date','event.session_count':'number','event.total_hours':'number','power_image.src':'asset','pricing.original_price':'number','pricing.current_price':'number','pricing.per_session_price':'number','pricing.session_count':'number','instructor.image.src':'asset'},OPTIONAL:{'event.second_session_date':1,'power_image.caption':1,'form.fields.full_name.placeholder':1,'form.fields.full_name.help':1,'form.fields.mobile.placeholder':1,'form.fields.mobile.help':1,'form.fields.email.placeholder':1,'form.fields.email.help':1,'form.fields.expertise.placeholder':1,'form.fields.expertise.help':1},READ_ONLY:{'form.privacy_note':1,'form.privacy_notice':1,'form.consent':1}};
function i18nPath_(p){return /^(meta\.(title|description)|accessibility\.skip_to_content|nav\.(brand_alt|navigation_label|language_label|open_menu|close_menu|home|about|services|process|contact|workshops)|layout_labels\.(conversion|story|program)|hero\.(eyebrow|title|subtitle|description|details_kicker|details_heading)|hero\.details\[[1-3]\]\.(label|value)|content_1\.(kicker|title)|content_1\.paragraphs\[[1-5]\]|content_2\.(kicker|title|intro)|content_2\.items\[[1-6]\]\.(title|text)|power_image\.(alt|caption)|ctas\.(after_content_1|after_power_image)|content_3\.(kicker|title|intro)|content_3\.items\[[1-3]\]\.(question|answer)|pricing\.(currency|vat_text|kicker|title|intro|original_label|current_label|session_label|breakdown_label|includes|deadline|after_deadline|cta)|instructor\.(kicker|title|role)|instructor\.image\.alt|instructor\.paragraphs\[[1-2]\]|form\.(kicker|title|intro|demo_notice|privacy_note|privacy_notice|consent|submit_label)|form\.fields\.(full_name|mobile|email|expertise)\.(label|placeholder|help)|form\.fields\.(full_name|mobile|email)\.errors\.(required|invalid)|form\.fields\.expertise\.errors\.(required|too_short|has_digit)|form\.status\.(fix_errors|no_registration|loading|success|failure|duplicate|rate_limited|challenge_failure|timeout|invalid|unavailable)|footer\.rights)$/.test(p);}
function schemaForPath_(p){if(i18nPath_(p))return {type:'i18n',required:!WORKSHOP_PUBLISH.OPTIONAL[p],writable:!WORKSHOP_PUBLISH.READ_ONLY[p]};if(WORKSHOP_PUBLISH.SCALAR[p])return {type:WORKSHOP_PUBLISH.SCALAR[p],required:!WORKSHOP_PUBLISH.OPTIONAL[p],writable:true};return null;}
function isAllowedWorkshopPath_(p){return !!schemaForPath_(p);}
function realDate_(v){var d=new Date(v+'T00:00:00Z');return /^\d{4}-\d{2}-\d{2}$/.test(v)&&!isNaN(d.getTime())&&d.toISOString().slice(0,10)===v;}
function validateWorkshopRow_(r){var s=schemaForPath_(r.path);if(!s)return 'YAML path is not allowed';if(r.type!==s.type)return 'row type does not match schema';if(r.state==='\u05d9\u05e9 \u05dc\u05d9\u05d9\u05d1\u05d0')return 'row must be imported';if(/[\u0000\r\n]/.test(r.he+r.en+r.ru))return 'multiline values are not allowed';if(!s.writable)return '';if(s.type==='i18n'&&(s.required||r.he||r.en||r.ru)&&(!r.he||!r.en||!r.ru))return 'i18n requires HE/EN/RU';if(s.required&&!r.he.trim())return 'required value missing';if(s.type==='boolean'&&!/^(true|false)$/i.test(r.he.trim()))return 'boolean required';if(s.type==='number'&&!/^\d+(?:\.\d+)?$/.test(r.he.trim()))return 'non-negative number required';if(s.type==='date'&&r.he.trim()&&!realDate_(r.he.trim()))return 'real YYYY-MM-DD date required';if(s.type==='id'&&!/^[A-Za-z0-9._-]{1,64}$/.test(r.he.trim()))return 'invalid id';if(s.type==='asset'&&!/^\.\/assets\/images\/[A-Za-z0-9._-]+\.(webp|png|jpg)$/.test(r.he.trim()))return 'invalid asset path';return '';}
function yamlValue_(r,t){if(t==='i18n')return '{he: '+JSON.stringify(String(r.he))+', en: '+JSON.stringify(String(r.en))+', ru: '+JSON.stringify(String(r.ru))+'}';if(t==='boolean')return r.he.trim().toLowerCase();if(t==='number')return r.he.trim();if(t==='date'&&!r.he.trim())return 'null';return JSON.stringify(String(r.he));}
function esc_(s){return s.replace(/[^A-Za-z0-9_]/g,function(c){return '\\'+c;});}
function brace_(s,n){var d=0,q=false,e=false;for(var i=n;i<s.length;i++){var c=s.charAt(i);if(q){if(!e&&c==='"')q=false;e=!e&&c==='\\';continue;}if(c==='"')q=true;else if(c==='{')d++;else if(c==='}'&&--d===0)return i;}throw new Error('malformed inline YAML map');}
function inline_(line,keys,val){if(!keys.length)return line.replace(/(-\s*).*/,'$1'+val);var at=0;for(var i=0;i<keys.length;i++){var m=new RegExp('(?:^|[, {])'+esc_(keys[i])+':\\s*').exec(line.slice(at));if(!m)throw new Error('YAML inline key missing: '+keys.join('.'));at+=m.index+m[0].length;if(i===keys.length-1){if(line.charAt(at)==='{'){var z=brace_(line,at);return line.slice(0,at)+val+line.slice(z+1);}var e=line.indexOf(',',at);if(e<0)e=line.indexOf('}',at);if(e<0)throw new Error('YAML inline scalar malformed');return line.slice(0,at)+val+line.slice(e);}if(line.charAt(at)!=='{')throw new Error('YAML inline map missing: '+keys.join('.'));}}
function replaceYamlPath_(yaml,r,t){var a=yaml.split('\n'),p=r.path.match(/[A-Za-z0-9_]+(?:\[\d+\])?/g),root=p.shift(),at=-1,end=a.length,i;for(i=0;i<a.length;i++)if(new RegExp('^'+esc_(root)+':').test(a[i])){at=i;break;}if(at<0)throw new Error('YAML key missing: '+r.path);if(!p.length){a[at]=a[at].replace(/^([^:]+:\s*).*/,'$1'+yamlValue_(r,t));return a.join('\n');}if(/\{/.test(a[at])&&p.length===1){a[at]=inline_(a[at],p,yamlValue_(r,t));return a.join('\n');}for(i=at+1;i<a.length;i++)if(/^[^\s#][^:]*:/.test(a[i])){end=i;break;}var indent=2,inline=-1,rest=[];for(var j=0;j<p.length;j++){var x=p[j].match(/^([A-Za-z0-9_]+)(?:\[(\d+)\])?$/),key=x[1],idx=x[2],hit=-1;for(i=at+1;i<end;i++)if(new RegExp('^ {'+indent+'}'+esc_(key)+':').test(a[i])){hit=i;break;}if(hit<0)throw new Error('YAML key missing: '+r.path);if(idx){var count=0;for(i=hit+1;i<end;i++)if(new RegExp('^ {'+(indent+2)+'}- ').test(a[i])&&++count===Number(idx)){inline=i;break;}if(inline<0)throw new Error('YAML array item missing: '+r.path);rest=p.slice(j+1);break;}if(j===p.length-1){a[hit]=a[hit].replace(/^([^:]+:\s*).*/,'$1'+yamlValue_(r,t));return a.join('\n');}if(/\{/.test(a[hit])){inline=hit;rest=p.slice(j+1);break;}at=hit;indent+=2;}if(inline<0)throw new Error('YAML format unsupported: '+r.path);a[inline]=inline_(a[inline],rest,yamlValue_(r,t));return a.join('\n');}
function patchWorkshopYaml_(yaml,rows){var out=yaml;rows.forEach(function(r){var s=schemaForPath_(r.path);if(s&&s.writable)out=replaceYamlPath_(out,r,s.type);});return out;}
function assertDraftEventSchema_(yaml){var b=yaml.match(/^event:\n((?:  [^\n]*\n?)*)/m);if(!b)throw new Error('Draft branch is not synced to the local event schema: event block is missing. Sync the draft baseline before publishing.');var need=['workshop_id','timezone','first_session_date','second_session_date','session_count','total_hours'],got={};b[1].replace(/^  ([a-z_]+):/gm,function(_,k){if(got[k])throw new Error('Draft event schema has duplicate key: '+k);got[k]=1;});for(var i=0;i<need.length;i++)if(!got[need[i]])throw new Error('Draft branch is not synced to the local event schema: missing event.'+need[i]+'. Sync the draft baseline before publishing.');}
function onOpen(){SpreadsheetApp.getUi().createMenu('\u05e1\u05d3\u05e0\u05d0\u05d5\u05ea').addItem('\u05d1\u05d3\u05d9\u05e7\u05d4','validateWorkshopSheet').addItem('\u05d3\u05d7\u05d9\u05e4\u05d4','pushWorkshopChangesToGitHub').addToUi();}
function validateWorkshopRows_(){var sh=workshopSheet_(),last=sh.getLastRow(),v=sh.getRange(WORKSHOP_PUBLISH.HEADER_ROW,1,last-WORKSHOP_PUBLISH.HEADER_ROW+1,WORKSHOP_PUBLISH.COLUMN_COUNT).getDisplayValues(),rows=[],bad=[],seen={};assertHeaders_(v[0]);for(var i=1;i<v.length;i++){var x=v[i],r={rowNumber:i+WORKSHOP_PUBLISH.HEADER_ROW,path:x[1].trim(),he:x[3],en:x[4],ru:x[5],type:x[6].trim(),required:x[7].trim(),state:x[8].trim()};if(x.join('').trim()==='')continue;var e=seen[r.path]?'duplicate YAML path':validateWorkshopRow_(r);seen[r.path]=1;sh.getRange(r.rowNumber,9).setValue(e||'\u05ea\u05e7\u05d9\u05df');if(e)bad.push(e);else rows.push(r);}return {ok:!bad.length,rows:rows,errors:bad};}
function validateWorkshopSheet(){return validateWorkshopRows_();}
function pushWorkshopChangesToGitHub(){var p=PropertiesService.getScriptProperties(),token=p.getProperty('GH_WORKSHOP_PAT');if(p.getProperty('WORKSHOP_PUBLISH_ARMED')!==WORKSHOP_PUBLISH.ARMED_VALUE)throw new Error('Publishing is not armed.');if(!token)throw new Error('GH_WORKSHOP_PAT is missing.');var v=validateWorkshopRows_();if(!v.ok)throw new Error('Sheet validation failed.');var url=githubContentsUrl_(),cur=githubFetchJson_(url,token,'get'),old=Utilities.newBlob(Utilities.base64Decode(cur.content.replace(/\s/g,''))).getDataAsString('UTF-8');assertDraftEventSchema_(old);var next=patchWorkshopYaml_(old,v.rows);if(next===old)throw new Error('No content change to publish.');var res=UrlFetchApp.fetch(url,{method:'put',contentType:'application/json',payload:JSON.stringify({message:'workshop: sheet content update',branch:WORKSHOP_PUBLISH.BRANCH,sha:cur.sha,content:Utilities.base64Encode(Utilities.newBlob(next).getBytes())}),headers:githubHeaders_(token),muteHttpExceptions:true});if(res.getResponseCode()<200||res.getResponseCode()>299)throw new Error('GitHub publish failed (HTTP '+res.getResponseCode()+').');}
function workshopSheet_(){var s=SpreadsheetApp.getActive().getSheetByName(WORKSHOP_PUBLISH.SHEET_NAME);if(!s)throw new Error('Workshop admin sheet missing.');return s;}function assertHeaders_(a){for(var i=0;i<WORKSHOP_PUBLISH.HEADERS.length;i++)if(a[i]!==WORKSHOP_PUBLISH.HEADERS[i])throw new Error('Workshop sheet headers changed.');}function githubContentsUrl_(){return 'https://api.github.com/repos/'+WORKSHOP_PUBLISH.REPO+'/contents/'+WORKSHOP_PUBLISH.FILE+'?ref='+WORKSHOP_PUBLISH.BRANCH;}function githubHeaders_(t){return {Authorization:'Bearer '+t,Accept:'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'};}function githubFetchJson_(u,t,m){var r=UrlFetchApp.fetch(u,{method:m,headers:githubHeaders_(t),muteHttpExceptions:true});if(r.getResponseCode()<200||r.getResponseCode()>299)throw new Error('GitHub read failed (HTTP '+r.getResponseCode()+').');return JSON.parse(r.getContentText());}
